# OpenAI-compatible LLM endpoint (agent + vision). Any provider with tool calling and image input works.
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
VISION_MODEL=google/gemma-4-31B-it

# simulator (default, no Ring account needed) or live
RING_MODE=simulator
APP_TZ=America/Los_Angeles

# Live mode only (see docs/ring-live-checklist.md)
RING_HMAC_KEY=
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_DOORBELL_ID=
RING_CHIME_ID=
