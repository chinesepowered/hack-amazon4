# OpenAI-compatible LLM endpoint (agent + vision). Any provider with tool calling and image input works.
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
VISION_MODEL=google/gemma-4-31B-it

# simulator = no network, everything faked with the documented Ring shapes (default)
# hybrid    = real Ring reads (devices, capabilities, status) + simulated events/snapshots/chime,
#             each labeled in the UI. Needs RING_ACCESS_TOKEN; falls back to simulator without one.
# live      = every call hits api.amazonvision.com (needs a Ring account with devices)
RING_MODE=simulator
APP_TZ=America/Los_Angeles

# Ring credentials (see docs/ring-live-checklist.md)
RING_HMAC_KEY=
# A Developer Playground token (~30 minutes) is enough for hybrid mode
RING_ACCESS_TOKEN=
# ...or OAuth credentials for a linked Ring account (do not set together with RING_ACCESS_TOKEN)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Optional: pin device ids. Left empty, hybrid mode discovers them from GET /v1/devices.
RING_DOORBELL_ID=
RING_CHIME_ID=
